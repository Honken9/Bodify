# ── Cloudflare ────────────────────────────────────────────────
# Ditt Zero Trust-team, t.ex. dittteam.cloudflareaccess.com
CF_TEAM_DOMAIN=
# Access-applikationens AUD-tag (Zero Trust → Access → Applications)
CF_ACCESS_AUD=
# Tunnel-token (Zero Trust → Networks → Tunnels → din tunnel)
TUNNEL_TOKEN=

# Valfritt men rekommenderat: låter admin bjuda in testare direkt från
# appen. API-token med "Access: Apps and Policies – Edit".
# Account-ID syns i dashboardens URL; app-ID är Access-applikationens UUID.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ACCESS_APP_ID=

# ── Databas ───────────────────────────────────────────────────
DB_PASSWORD=byt-mig

# ── Användare ─────────────────────────────────────────────────
# Denna adress blir admin vid sin första inloggning
BOOTSTRAP_ADMIN_EMAIL=daniel.holmkvist@gmail.com
# true = alla som släpps igenom Access-vitlistan får konto automatiskt
AUTO_PROVISION_USERS=true

# ── App ───────────────────────────────────────────────────────
# Långt slumpvärde — krypterar OAuth-tokens i vila (openssl rand -hex 32)
SECRET_KEY=
# Publik URL (OAuth-redirects & webhooks)
PUBLIC_BASE_URL=https://bodify.dindomän.se

# ── Strava (https://www.strava.com/settings/api) ─────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=bodify-strava

# ── Withings (https://developer.withings.com) ────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# ── Web Push (npx web-push generate-vapid-keys) ──────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:daniel.holmkvist@gmail.com

# ── AI (Ollama) ───────────────────────────────────────────────
# På Mac: kör Ollama som vanlig app (ollama.com) — då används GPU:n.
# Peka då containrarna mot värddatorn:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=qwen2.5vl
